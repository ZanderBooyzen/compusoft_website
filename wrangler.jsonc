{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-flux-capacitor",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-24",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compusoft-business",
      "database_id": "8002aa03-c4c8-48de-b238-7ef4a8f26b1e",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [
    { "pattern": "www.zanderbooyzen.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitorCounter"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "zanderbooyzen@gmail.com",
      "allowed_sender_addresses": ["mail@zanderbooyzen.com"]
    }
  ]
}
